{
  "id": null,
  "uid": "load-testing-dashboard",
  "title": "Load Testing Dashboard",
  "description": "Monitoring run-level metrics from loadtest_summary",
  "tags": ["threads", "load-testing"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
      {
        "id": 1,
        "title": "Latest run latency (p95/avg/median)",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "datasource": { "type": "influxdb", "uid": "influxdb" },
        "targets": [
          {
            "query": "from(bucket: \"threads\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"loadtest_summary\")\n  |> filter(fn: (r) => r.test_case == \"1\")\n  |> filter(fn: (r) => r._field == \"p95_ms\" or r._field == \"avg_ms\" or r._field == \"median_ms\")\n  |> group(columns:[\"_field\"]) \n  |> last()",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "color": {
              "mode": "palette-classic"
            },
            "mappings": [],
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
          },
          "overrides": []
        }
      },
      {
        "id": 2,
        "title": "Latest run: throughput / errors / tail",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "datasource": { "type": "influxdb", "uid": "influxdb" },
        "targets": [
          {
            "query": "from(bucket: \"threads\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"loadtest_summary\")\n  |> filter(fn: (r) => r.test_case == \"1\")\n  |> filter(fn: (r) => r._field == \"throughput_rps\" or r._field == \"error_count\" or r._field == \"tail_s\")\n  |> group(columns:[\"_field\"]) \n  |> last()",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        }
      },
      {
        "id": 3,
        "title": "Latest run: client share (hybrid only)",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "datasource": { "type": "influxdb", "uid": "influxdb" },
        "targets": [
          {
            "query": "from(bucket: \"threads\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"loadtest_summary\")\n  |> filter(fn: (r) => r.test_case == \"3\")\n  |> filter(fn: (r) => r._field == \"client_share\" or r._field == \"redirected_ok_count\")\n  |> group(columns:[\"_field\"]) \n  |> last()",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "blue",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        }
      },
      {
        "id": 4,
        "title": "Run history (p95_ms by test_case)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 12
        },
        "datasource": { "type": "influxdb", "uid": "influxdb" },
        "targets": [
          {
            "query": "from(bucket: \"threads\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"loadtest_summary\")\n  |> filter(fn: (r) => r._field == \"p95_ms\")\n  |> group(columns:[\"test_case\"]) \n  |> sort(columns:[\"_time\"])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        }
      }
    ],
  "timepicker": {}
}